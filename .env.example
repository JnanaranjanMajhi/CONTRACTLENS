# =============================================================================
# ContractLens Production & Local Environment Variables
# =============================================================================

# [REQUIRED - Backend Server Only]
# Google Gemini API key (Server-side only — never exposed to client)
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL - Backend]
# Gemini Model ID (defaults to gemini-3.8-flash, with automatic fallback)
GEMINI_MODEL=gemini-3.8-flash

# [OPTIONAL - Backend]
# Server Port (Render/Heroku/Railway provide PORT automatically; default: 3001)
PORT=3001

# [OPTIONAL - Backend]
# Allowed CORS origins for browser access (comma-separated, e.g. https://contractlens.vercel.app)
# If left blank, supports localhost during development
ALLOWED_ORIGINS=

# [OPTIONAL - Frontend]
# Backend API Base URL (only required if frontend is hosted on a separate domain from backend)
# Example: https://contractlens-api.onrender.com (leave blank for same-origin or Vite dev proxy)
VITE_API_URL=
